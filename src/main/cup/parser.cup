package gr.hua.dit.compilers;

import java_cup.runtime.*;
import java.util.List;
import java.util.ArrayList;
import gr.hua.dit.compilers.ast.*;

parser code {:
    // Connect this parser to a scanner!
    Lexer lexer;
    public parser(Lexer lexer) {
        super(lexer);
        this.lexer = lexer;
    }

    @Override
        public void syntax_error(Symbol cur_token) {
            int line = cur_token.left + 1;
            int column = cur_token.right + 1;
            String tokenVal = cur_token.value != null ? cur_token.value.toString() : "";
            System.err.println("Syntax error at line " + line + ", column " + column + ". Unexpected token: " + tokenVal);
        }
:}

/* Terminals (tokens returned by the scanner). */
/* Keywords */
terminal AND, BOOL, CHAR, DECL, DEF,
          ELSE, ELSIF, END, EXIT, FALSE,
          FOR, HEAD, IF, INT, LIST,
          MOD, NEW, NIL, NILQ, NOT,
          OR, REF, RETURN, SKIP, TAIL,
          TRUE;

/* Operators */
terminal PLUS, MINUS, MULT, DIV, HASH, EQ, NEQ, LT,
          GT, LEQ, GEQ;

/* Seperators */
terminal LPAR, RPAR, LBRAC, RBRAC, COMMA, SEMICOLON, COLON, ASSIGN;

/* Constants and identifiers */
terminal String ID, STRING;
terminal Character CHARACTER;
terminal Integer INTEGER;

/* Dummy terminals used exclusively for enforcing Unary Operator Precedence */
terminal UMINUS, UPLUS;

/*Non-terminals*/
non terminal ProgramNode program;
non terminal FuncDefNode func_def;
non terminal FuncDeclNode func_decl;
non terminal VarDefNode var_def;
non terminal HeaderNode header;
non terminal FormalNode formal;
non terminal TypeNode type;
non terminal Stmt stmt, simple;
non terminal CallNode call;
non terminal Expr atom, expr;
non terminal List def_decl_list;
non terminal ASTNode def_decl_item;
non terminal List stmt_list;
non terminal TypeNode optional_type;
non terminal List optional_formal_list, formal_list;
non terminal Boolean optional_ref;
non terminal List id_list;
non terminal List elsif_list;
non terminal List optional_else;
non terminal List simple_list;
non terminal List optional_expr_list, expr_list;

/* Precedence */
precedence left OR;
precedence left AND;
precedence nonassoc NOT;
precedence nonassoc EQ, NEQ, LT, GT, LEQ, GEQ;
precedence right HASH;
precedence left PLUS, MINUS;
precedence left MULT, DIV, MOD;
/* * Precedence rules to resolve ambiguities.
 * UMINUS and UPLUS are dummy terminals used to assign the highest priority
 * to unary minus/plus, ensuring expressions like "-x * y" are parsed correctly.
 */
precedence nonassoc UMINUS, UPLUS;

/* Grammar rules & AST generation */
start with program;

program ::= func_def:f {: RESULT = new ProgramNode(f); :} ;

func_def ::= DEF header:h COLON def_decl_list:dl stmt_list:sl END
             {: RESULT = new FuncDefNode(h, dl, sl); :} ;

def_decl_list ::= def_decl_list:l def_decl_item:i {: l.add(i); RESULT = l; :}
                | /* empty */ {: RESULT = new ArrayList(); :} ;

def_decl_item ::= func_def:f  {: RESULT = f; :}
                | func_decl:d {: RESULT = d; :}
                | var_def:v   {: RESULT = v; :} ;

header ::= optional_type:t ID:name LPAR optional_formal_list:fl RPAR
           {: RESULT = new HeaderNode(t, name, fl); :} ;

optional_type ::= type:t {: RESULT = t; :}
                | /* empty */ {: RESULT = null; :} ;

optional_formal_list ::= formal_list:fl {: RESULT = fl; :}
                       | /* empty */ {: RESULT = new ArrayList(); :} ;

formal_list ::= formal_list:l SEMICOLON formal:f {: l.add(f); RESULT = l; :}
              | formal:f {: List l = new ArrayList(); l.add(f); RESULT = l; :} ;

formal ::= optional_ref:r type:t id_list:il {: RESULT = new FormalNode(r, t, il); :} ;

optional_ref ::= REF {: RESULT = true; :}
               | /* empty */ {: RESULT = false; :} ;

type ::= INT  {: RESULT = new TypeNode("int"); :}
       | BOOL {: RESULT = new TypeNode("bool"); :}
       | CHAR {: RESULT = new TypeNode("char"); :}
       | type:t LBRAC RBRAC      {: RESULT = new ArrayTypeNode(t); :}
       | LIST LBRAC type:t RBRAC {: RESULT = new ListTypeNode(t); :} ;

func_decl ::= DECL header:h {: RESULT = new FuncDeclNode(h); :} ;

var_def ::= type:t id_list:il {: RESULT = new VarDefNode(t, il); :} ;

id_list ::= id_list:l COMMA ID:i {: l.add(i); RESULT = l; :}
          | ID:i {: List l = new ArrayList(); l.add(i); RESULT = l; :} ;

stmt_list ::= stmt_list:l stmt:s {: l.add(s); RESULT = l; :}
            | stmt:s {: List l = new ArrayList(); l.add(s); RESULT = l; :} ;

stmt ::= simple:s {: RESULT = s; :}
       | EXIT     {: RESULT = new ExitStmt(); :}
       | RETURN expr:e {: RESULT = new ReturnStmt(e); :}
       /* * IF Statement:
        * Handles the standard 'if' block, an optional list of 'elsif' blocks,
        * and an optional 'else' block.
        */
       | IF expr:cond COLON stmt_list:sl elsif_list:el optional_else:oe END
         {: RESULT = new IfStmt(cond, sl, el, oe); :}
       /* * FOR Loop:
        * Follows the syntax: for <init>; <cond>; <step>: <body> end
        * Note that both <init> and <step> can be comma-separated lists of simple statements.
        */
       | FOR simple_list:inits SEMICOLON expr:cond SEMICOLON simple_list:step COLON stmt_list:body END
         {: RESULT = new ForStmt(inits, cond, step, body); :} ;

elsif_list ::= elsif_list:l ELSIF expr:cond COLON stmt_list:sl
               {: l.add(new ElsifStmt(cond, sl)); RESULT = l; :}
             | /* empty */ {: RESULT = new ArrayList(); :} ;

optional_else ::= ELSE COLON stmt_list:sl {: RESULT = sl; :}
                | /* empty */ {: RESULT = null; :} ;

simple ::= SKIP {: RESULT = new SkipStmt(); :}
         | atom:a ASSIGN expr:e {: RESULT = new AssignStmt(a, e); :}
         | call:c {: RESULT = new CallStmt(c); :} ;

simple_list ::= simple_list:l COMMA simple:s {: l.add(s); RESULT = l; :}
              | simple:s {: List l = new ArrayList(); l.add(s); RESULT = l; :} ;

call ::= ID:name LPAR optional_expr_list:el RPAR {: RESULT = new CallNode(name, el); :} ;

optional_expr_list ::= expr_list:el {: RESULT = el; :}
                     | /* empty */  {: RESULT = new ArrayList(); :} ;

expr_list ::= expr_list:l COMMA expr:e {: l.add(e); RESULT = l; :}
            | expr:e {: List l = new ArrayList(); l.add(e); RESULT = l; :} ;

atom ::= ID:i {: RESULT = new IdNode(i); :}
       | STRING:s {: RESULT = new StringNode(s); :}
       | atom:a LBRAC expr:e RBRAC {: RESULT = new ArrayAccessNode(a, e); :}
       | call:c {: RESULT = c; :} ;

expr ::= atom:a {: RESULT = a; :}
       | INTEGER:i {: RESULT = new IntegerNode(i); :}
       | CHARACTER:c {: RESULT = new CharNode(c); :}
       | LPAR expr:e RPAR {: RESULT = e; :}
       /* Unary operators (Bound to UPLUS/UMINUS precedence to override binary +/-) */
       | PLUS expr:e  {: RESULT = new UnaryPlusNode(e); :} %prec UPLUS
       | MINUS expr:e {: RESULT = new UnaryMinusNode(e); :} %prec UMINUS
       | NOT expr:e {: RESULT = new NotNode(e); :}
       | NILQ LPAR expr:e RPAR {: RESULT = new NilqNode(e); :}
       | HEAD LPAR expr:e RPAR {: RESULT = new HeadNode(e); :}
       | TAIL LPAR expr:e RPAR {: RESULT = new TailNode(e); :}
       | expr:e1 PLUS expr:e2  {: RESULT = new AddNode(e1, e2); :}
       | expr:e1 MINUS expr:e2 {: RESULT = new SubNode(e1, e2); :}
       | expr:e1 MULT expr:e2  {: RESULT = new MultNode(e1, e2); :}
       | expr:e1 DIV expr:e2   {: RESULT = new DivNode(e1, e2); :}
       | expr:e1 MOD expr:e2   {: RESULT = new ModNode(e1, e2); :}
       | expr:e1 EQ expr:e2    {: RESULT = new EqNode(e1, e2); :}
       | expr:e1 NEQ expr:e2   {: RESULT = new NeqNode(e1, e2); :}
       | expr:e1 LT expr:e2    {: RESULT = new LtNode(e1, e2); :}
       | expr:e1 GT expr:e2    {: RESULT = new GtNode(e1, e2); :}
       | expr:e1 LEQ expr:e2   {: RESULT = new LeqNode(e1, e2); :}
       | expr:e1 GEQ expr:e2   {: RESULT = new GeqNode(e1, e2); :}
       | expr:e1 AND expr:e2   {: RESULT = new AndNode(e1, e2); :}
       | expr:e1 OR expr:e2    {: RESULT = new OrNode(e1, e2); :}
       | expr:e1 HASH expr:e2  {: RESULT = new ConsNode(e1, e2); :}
       | TRUE  {: RESULT = new BooleanNode(true); :}
       | FALSE {: RESULT = new BooleanNode(false); :}
       | NEW type:t LBRAC expr:e RBRAC {: RESULT = new NewArrayNode(t, e); :}
       | NIL {: RESULT = new NilNode(); :} ;
